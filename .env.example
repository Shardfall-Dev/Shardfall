# Shardfall server environment. Copy to .env for local development (.env is git-ignored); in production set these in the
# host's secret store. Never commit real values. Values below work with server/dev/docker-compose.yml.

NODE_ENV=development
# Where players reach the game. The server serves the game page and the API from this one origin (cookies stay first-party).
PUBLIC_URL=http://localhost:8787
PORT=8787
# HOST=127.0.0.1            # 0.0.0.0 in production (default there)
# ALLOWED_ORIGINS=          # extra exact origins allowed to call the API / open the WebSocket (comma separated). Usually empty.
# TRUST_PROXY=true          # behind a reverse proxy / load balancer that sets X-Forwarded-For (Fly.io, Render, Caddy, nginx)

# PostgreSQL. Supabase: Project Settings → Database → connection string (session pooler or direct; port 5432).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/postgres
# DATABASE_SSL=verify       # off | verify | no-verify  (default: off for localhost, verify otherwise)

# Supabase Auth. Supabase project: https://<project-ref>.supabase.co/auth/v1   Supabase CLI: http://127.0.0.1:54321/auth/v1
# server/dev/docker-compose.yml: http://localhost:9999
SUPABASE_AUTH_URL=http://localhost:9999
# Publishable / anon key (public by design). Local dev: node --import tsx server/dev/keys.ts
SUPABASE_ANON_KEY=replace-with-anon-key
# Secret / service_role key: SERVER ONLY, used solely to delete a user's identity when they delete their account.
# Leave empty to disable account deletion (the button explains it is not configured).
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64: encrypts the Supabase tokens and PKCE verifiers stored with each session.
#   openssl rand -base64 32
# Rotating it signs everyone out (stored tokens can no longer be read).
SESSION_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Google and Apple sign-in: configure the provider in Supabase Auth first (dashboard → Authentication → Providers), then turn
# it on here. A provider button appears only when it is on here AND enabled in Supabase Auth.
OAUTH_GOOGLE_ENABLED=false
OAUTH_APPLE_ENABLED=false

# Optional tuning (defaults shown)
# SESSION_TTL_HOURS=720          # absolute session lifetime
# SESSION_IDLE_HOURS=168         # signed out after this long without a request
# REAUTH_WINDOW_MINUTES=10       # how recent a sign-in must be for linking, email change, deletion
# PROVIDER_RECHECK_MINUTES=10    # how often a session re-confirms the user with Supabase Auth
# CHARACTER_PURGE_DAYS=7         # deleted characters can be restored (and keep their name) this long
# RATE_LIMIT_PER_MINUTE=300      # per IP, all routes
# AUTH_RATE_LIMIT_PER_MINUTE=10  # per IP, sign-in / sign-up / reset routes
# COOKIE_SECURE=                 # defaults to true for https PUBLIC_URL; may only be false for http://localhost
# SERVE_GAME=true                # serve the newest Shardfall_v*.html at / and its audio under /assets/
# LOG_LEVEL=info
